# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional free-tier dialogue TTS fallbacks. Keep these server-side only.
# Google Cloud: enable Text-to-Speech, create a least-privilege service account,
# then paste its one-line JSON or base64-encoded JSON into one of these values.
GOOGLE_CLOUD_TTS_CREDENTIALS_JSON=""
GOOGLE_CLOUD_TTS_CREDENTIALS_BASE64=""

# Azure: create a Speech resource using the Free F0 pricing tier, then copy its
# key and region (for example: southeastasia).
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
